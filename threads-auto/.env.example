# Meta Threads 앱 자격증명 (developers.facebook.com 앱 설정에서 발급)
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret

# 최초 1회 필요한 액세스 토큰(단기 또는 장기).
# 저장된 유효 토큰(.token.json)이 있으면 자동 refresh 되므로 이후에는 없어도 된다.
ACCESS_TOKEN=your_access_token

# 선택: Threads 사용자 ID. 미설정 시 'me'로 토큰 소유자를 자동 조회.
# THREADS_USER_ID=me

# 콘텐츠 자동 생성(content_generator.py)에 필요
OPENAI_API_KEY=your_openai_api_key

# 발행 요일(KST, 콤마 구분). 미설정 시 mon,wed,fri → 주 3회
# 주 4회로 늘리려면 요일을 하나 더 넣는다(예: mon,wed,fri,sun)
# POST_DAYS=mon,wed,fri

# 발행 시각(KST, 콤마 구분). 미설정 시 18:30
# 주 3~4회를 유지하려면 시각은 하나만 둔다(요일 수 × 시각 수 = 주간 발행 횟수)
# POST_TIMES=18:30

# 콘텐츠 큐 백엔드: json(기본) / postgres / supabase
# CONTENT_QUEUE_BACKEND=json
# QUEUE_FILE=queue.json

# CONTENT_QUEUE_BACKEND=postgres 일 때만 필요 (tenbagger 백엔드와 같은 DB)
# DATABASE_URL=postgresql://user:pass@host:5432/tenbagger

# CONTENT_QUEUE_BACKEND=supabase 일 때만 필요
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=your_service_role_key

# 토큰 저장 파일 경로(기본 .token.json)
# TOKEN_FILE=.token.json
